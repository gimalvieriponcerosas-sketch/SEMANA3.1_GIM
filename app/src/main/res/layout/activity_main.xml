<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- PANTALLA 0: MENÚ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:gravity="center"
                    android:text="MUNICIPALIDAD DISTRITAL DE CHINCHAO"
                    android:textColor="#17365D"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Sistema de Gestión"
                    android:textColor="#555555"
                    android:textSize="17sp"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="45dp"/>

                <Button
                    android:id="@+id/btnEmpleados"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:text="👤  EMPLEADOS"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnTramites"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="15dp"
                    android:text="📄  TRÁMITES"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnBuscarEmpleado"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_marginTop="15dp"
                    android:text="🔎  BUSCAR EMPLEADO"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </ScrollView>

        <!-- PANTALLA 1: EMPLEADOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnVolverEmpleados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬅ Volver"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="EMPLEADOS"
                    android:textColor="#17365D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ListView
                android:id="@+id/listViewEmpleados"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnAgregarEmpleado"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="16dp"
                android:text="➕  AGREGAR EMPLEADO"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- PANTALLA 2: TRÁMITES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnVolverTramites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬅ Volver"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="TRÁMITES"
                    android:textColor="#17365D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ListView
                android:id="@+id/listViewTramites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnAgregarTramite"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="16dp"
                android:text="➕  AGREGAR TRÁMITE"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- PANTALLA 3: BUSCAR EMPLEADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnVolverBuscar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬅ Volver"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="BUSCAR EMPLEADO"
                    android:textColor="#17365D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:hint="Buscar por nombre, apellido o DNI"/>

            <ListView
                android:id="@+id/listViewBuscar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

    </ViewFlipper>
</FrameLayout>